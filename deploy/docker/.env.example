# docker compose 用的变量文件：cp 成 .env 再改（.env 已被 gitignore，不会进仓库）
#
# 这个文件同时干两件事：① compose 插值（端口/域名/证书路径）② 传给 server 容器的模型配置。

# ---- 宿主端口：刻意避开 80/443，留给后续服务或统一网关 ----
A2UI_HTTP_PORT=8080
A2UI_HTTPS_PORT=8443

# ---- nginx 的 server_name ----
# 有域名就写（多个空格分隔），末尾加 `_` 兜住其它 Host；没有域名就只写 `_`
A2UI_SERVER_NAME="yakult.work www.yakult.work _"

# ---- 证书（宿主的 /etc/letsencrypt 整棵只读挂进容器）----
# A2UI_CERT_NAME 是 /etc/letsencrypt/live 下的目录名；留空或目录不存在 → 自动降级成 HTTP-only。
# 注意别只挂 live/<域名>：那里全是软链，单挂会变断链（踩过）。
A2UI_CERT_ROOT=/etc/letsencrypt
A2UI_CERT_NAME=yakult.work

# ---- ACME 校验目录（可选，宿主 certbot --webroot 用）----
A2UI_ACME_DIR=/var/www/a2ui-acme

# ---- 模型 ----
AGENT_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=

# ---- 构建加速（国内机器强烈建议换镜像源，否则 pnpm install 会很慢）----
# NPM_REGISTRY=https://registry.npmmirror.com

# 其余可选参数（不填就用服务端缺省值）
# OPENAI_TEMPERATURE=0.2
# HISTORY_LIMIT=12
# SESSION_TTL_MS=1800000
# MOCK_STREAM_DELAY_MS=0
# SCENARIO_CHUNK_SIZE=50
# AGENT_ICON_TOOLS=1
