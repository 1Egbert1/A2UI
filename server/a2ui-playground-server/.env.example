# a2ui-server 环境变量模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会进公开仓库）

# 服务端口
PORT=3000

# agent 实现：mock（默认，离线假数据）| openai（接真实模型）
# 接口与传输完全一致，切换只影响「谁来产出协议文本」。
AGENT_PROVIDER=mock

# ---- 以下仅在 AGENT_PROVIDER=openai 时需要 ----
# OPENAI_API_KEY=sk-xxxx
# 兼容网关（Azure / 自建代理 / 各类中转）时填，走官方留空即可
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2

# 每个会话保留的最大轮数
# HISTORY_LIMIT=12
# 会话空转回收时间（毫秒），0 表示不回收
# SESSION_TTL_MS=1800000
# mock 吐字间隔（毫秒），设成正数可以肉眼看到流式效果
# MOCK_STREAM_DELAY_MS=0
