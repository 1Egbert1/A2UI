# a2ui-server 环境变量模板
# 复制为 .env 后填上 Key 即可（.env 已被 .gitignore 忽略，不会进公开仓库）

# 服务端口
PORT=3000

# agent 实现：mock（默认，离线假数据）| openai（接真实模型产出 A2UI 协议）
# 只测模型对话（POST /api/a2ui/chat）时**不需要**改这一项 —— 那个接口总是打真实模型。
AGENT_PROVIDER=mock

# ---- 模型链接（OpenAI 兼容接口，这里默认配的是 DeepSeek）----
# base_url 与模型名都取自官方文档 https://api-docs.deepseek.com
#   deepseek-flash  → DeepSeek-V4.1-Flash（官方推荐名；旧的 deepseek-v4-flash 已下线）
#   deepseek-v4-pro → DeepSeek-V4-Pro（2026-09-14 起请求会被路由到 V4.1 Flash 计费）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# 把下面这行换成自己的 Key。也认 DEEPSEEK_API_KEY，两者都在时以 OPENAI_API_KEY 为准。
OPENAI_API_KEY=
# 采样温度，协议生成建议低（0.2 左右），纯聊天可以高一些
# OPENAI_TEMPERATURE=0.2

# ---- POST /api/a2ui/chat 的默认 system prompt（留空用内置的一句话）----
# CHAT_SYSTEM_PROMPT=你是一个乐于助人的中文助手，回答尽量简短。

# 每个会话保留的最大轮数
# HISTORY_LIMIT=12
# 会话空转回收时间（毫秒），0 表示不回收
# SESSION_TTL_MS=1800000
# 模拟吐字间隔（毫秒），设成正数可以肉眼看到流式效果（mock agent 与场景字符流都用它）
# MOCK_STREAM_DELAY_MS=0
# 场景字符流的默认块长（字符数）
# SCENARIO_CHUNK_SIZE=50
